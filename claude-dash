DASH_TTY=$(tty 2>/dev/null); DASH_TTY="${DASH_TTY#/dev/}"
SEL_SID=""; TOP_IDX=1; GOTO=""
PREV_NEED=0; CMD_MSG=""

# Full-screen shortcuts panel — stays up until a key is pressed (a one-frame
# flash in the input bar was too fast to read and got truncated).
show_help() {
  local c="$CYAN" m="$MUTED" k="$CYAN$B" d="$MUTED"
  printf '\033[H\033[2J%s' "$BG_MAIN"
  local L=()
  L+=("")
  L+=("  ${AMBER}${B}⚡ CLAUDE CODE — shortcuts${BOFF}${FR}")
  L+=("")
  L+=("  ${m}navigate${FR}")
  L+=("    ${k}↑ ↓${FR}${d}  or ${k}j k${FR}${d}   move selection — the view scrolls, the peek follows${FR}")
  L+=("    ${k}tab${FR}${d}         next session that needs you${FR}")
  L+=("    ${k}digits${FR}${d}      type a row number to jump to its tab — ${k}⏎${d} confirms 1–9${FR}")
  L+=("    ${k}⏎${FR}${d}           jump to the typed row, else attach to the selection${FR}")
  L+=("")
  L+=("  ${m}act${FR}")
  L+=("    ${k}y${FR}${d} / ${k}n${FR}${d}       approve / deny the permission prompt${FR}")
  L+=("    ${k}s${FR}${d}           send an instruction (queues if the session is busy)${FR}")
  L+=("    ${k}b${FR}${d}           broadcast one instruction to all sessions${FR}")
  L+=("    ${k}v${FR}${d}           speak a status briefing (again / esc to stop)${FR}")
  L+=("    ${k}a${FR}${d}           ask about the fleet by voice (dictate) or text${FR}")
  L+=("    ${k}:${FR}${d}           command mode${FR}")
  L+=("    ${k}q${FR}${d}           quit the dashboard (sessions keep running)${FR}")
  L+=("")
  L+=("  ${m}: commands${FR}  ${d}(target = selected row, or a number)${FR}")
  L+=("    ${c}:compact${FR}${d}  ${c}:clear${FR}${d}  ${c}:model <m>${FR}${d}  ${c}:all <msg>${FR}${d}  ${c}:attach [N]${FR}")
  L+=("    ${c}:kill [N]${FR}${d}  ${c}:refresh${FR}${d}  ${c}:quit${FR}${d}  ${c}:help${FR}")
  L+=("")
  L+=("  ${FAINT}press any key to return${FR}")
  local ln
  for ln in "${L[@]}"; do printf '%s %s\033[K\r\n' "$BG_MAIN" "$ln"; done
  printf '%s\033[J' "$BG_MAIN"
  IFS= read -rsn1 -t 60 _
}

cleanup() {
  [ -n "$SCAN_PID" ] && kill "$SCAN_PID" 2>/dev/null      # stop any background scan
  [ -n "$ASK_PID" ]  && kill "$ASK_PID" 2>/dev/null       # stop any background ask
  [ -n "$SAY_PID" ]  && kill "$SAY_PID" 2>/dev/null       # stop any speech
  [ -n "$SCAN_TMP" ] && rm -f "$SCAN_TMP" 2>/dev/null
  [ -n "$ASK_OUT" ]  && rm -f "$ASK_OUT" "$ASK_ERR" 2>/dev/null
  [ -n "$STTY_SAVE" ] && stty "$STTY_SAVE" 2>/dev/null   # restore line discipline
  printf '\033[?25h\033[?7h\033[0m\033[?1049l'; exit 0
}
trap cleanup INT TERM
# On resize just flag it: the interrupted read drops us back to the loop, which
# recomputes geometry and hard-clears (in-place overwrite can't be trusted after
# the terminal reflows the old frame).
RESIZED=0
trap 'RESIZED=1' WINCH

# Switch to the ALTERNATE screen buffer (?1049h): it has no scrollback, so a
# window resize just clips instead of reflowing old frames into scrollback
# garbage — and quitting restores whatever was on the shell before. Hide the
# cursor, DISABLE line-wrap (?7l), paint the canvas, clear once. Line-wrap must
# stay off: a full-width line that reaches the last column would otherwise
# auto-wrap to a new row and push the whole frame down on every refresh.
printf '\033[?1049h\033[?25l\033[?7l%s\033[2J' "$BG_MAIN"
# Put the terminal in non-canonical, no-echo mode for the whole session (restored
# in cleanup). Without this, bash's `read -n1` only flips to cbreak for the
# duration of each read and restores canonical (line-buffered) mode in between —
# so a second digit typed while the frame is rendering (e.g. the "4" of a quick
# "14") lands in the canonical line buffer and is dropped by the next read. That
# made two-digit row jumps fail unless you paused between the digits. `min 1
# time 0` = each read blocks until at least one byte is available.
STTY_SAVE=$(stty -g 2>/dev/null)
stty -icanon -echo min 1 time 0 2>/dev/null
# The session scan (collect: a jq pass per live session) costs ~1s and grows with
# the fleet — several seconds with a dozen-plus sessions. Running it inline froze
# ALL key input for its whole duration: after you typed the first digit of a
# two-digit jump, the scan blocked the loop and swallowed the second digit before
# it could be read, so "14" never reached row 14 (and navigation felt sluggish).
# Fix: run collect in the BACKGROUND (stdout -> a tmpfile, stdin from /dev/null so
# it can't grab your keystrokes). The loop kicks off a scan when one is due, keeps
# rendering and reading keys while it runs, and folds in the fresh data the moment
# the background job finishes. Key input is never blocked by a scan again.
DATA_INTERVAL=2
SCAN_TMP=$(mktemp -t claude-dash-scan 2>/dev/null || echo "/tmp/claude-dash-scan.$$")
# initial scan is synchronous so the first frame already shows the fleet
ROWS=$(collect </dev/null 2>/dev/null); parse_rows; resolve_selection
now=$(date +%s); last_data=$now; SCAN_PID=""; SCANNING=0
SAY_PID=""; ASK_PID=""; ASKING=0; ANSWER=""; ASK_OUT=""; ASK_ERR=""
PREV_COLS=0; PREV_LINES=0
while true; do
  compute_geometry
  # After a resize the terminal has reflowed the old frame, so overwriting in
  # place leaves fragments of the old layout behind — wipe the slate first.
  if [ "$RESIZED" = 1 ] || [ "$COLS_T" != "$PREV_COLS" ] || [ "$LINES_T" != "$PREV_LINES" ]; then
    RESIZED=0; PREV_COLS=$COLS_T; PREV_LINES=$LINES_T
    printf '%s\033[2J' "$BG_MAIN"
  fi
  now=$(date +%s)
  # fold in a finished background scan
  if [ "$SCANNING" = 1 ] && ! kill -0 "$SCAN_PID" 2>/dev/null; then
    SCANNING=0; last_data=$now
    ROWS=$(cat "$SCAN_TMP" 2>/dev/null); parse_rows; resolve_selection
    # ring the bell + note when a new session flips to needs-you
    local_need=0; i=1
    while [ $i -le "$NROWS" ]; do [ "${R_STATUS[$i]}" = waiting ] && local_need=$((local_need+1)); i=$((i+1)); done
    if [ "$BELL" = 1 ] && [ "$local_need" -gt "$PREV_NEED" ]; then printf '\a'; fi
    PREV_NEED=$local_need
  fi
  # kick off a new background scan when due and none is running
  if [ "$SCANNING" = 0 ] && [ $(( now - last_data )) -ge "$DATA_INTERVAL" ]; then
    collect </dev/null >"$SCAN_TMP" 2>/dev/null &
    SCAN_PID=$!; SCANNING=1
  fi
  # fold in a finished background "ask" (claude -p) -> speak the answer
  if [ "$ASKING" = 1 ] && ! kill -0 "$ASK_PID" 2>/dev/null; then
    ASKING=0; ANSWER=$(cat "$ASK_OUT" 2>/dev/null)
    if [ -n "$ANSWER" ]; then speak "$ANSWER"
    else
      ask_err=$(tr '\n' ' ' <"$ASK_ERR" 2>/dev/null | sed 's/  */ /g')
      CMD_MSG="ask failed: ${ask_err:-no output (is 'claude' on PATH?)}"
    fi
    rm -f "$ASK_OUT" "$ASK_ERR" 2>/dev/null
  fi

  render
  # Home the cursor and overwrite in place. Clamp to the terminal height (head)
  # and drop the trailing newline: printing a newline on the last row — or any
  # line past the last row — scrolls the screen, which would march the whole
  # dashboard upward every tick. The clamp also guards against an unusually tall
  # frame (e.g. many simultaneously-active rows on a short terminal).
  printf '\033[H%s%s\033[J%s' "$(printf '%s' "$FRAME" | head -n "$LINES_T")" "$BG_MAIN" "$RST"

  read_key
  # Any key other than a digit, ⏎, esc, or a refresh tick cancels a pending
  # "go to session" number so it can't leak into the next action.
  case "$KEY" in [0-9]|ENTER|ESC|'') ;; *) GOTO="" ;; esac
  case "$KEY" in
    UP|k)    move_sel -1 ;;
    DOWN|j)  move_sel +1 ;;
    TAB)     next_alert ;;
    [0-9])
      # Build a row number across keystrokes and show it live in the input bar.
      # There's no blocking read and no timeout, so "14" always goes to 14 no
      # matter how fast or slow you type, and a lone lead digit never yanks you
      # to the wrong tab. Ignore a leading zero (no row 0) and any digit that
      # would overshoot NROWS. Jump the instant the number can't grow to another
      # valid row (e.g. "14" when the fleet has 16 rows); otherwise wait for the
      # next digit or ⏎.
      if [ -n "$GOTO" ] || [ "$KEY" != 0 ]; then
        gnew="${GOTO}${KEY}"; g=$(( 10#$gnew ))
        if [ "$g" -le "$NROWS" ]; then
          GOTO="$gnew"
          if [ $(( g * 10 )) -gt "$NROWS" ]; then focus_tab "${R_TTY[$g]}"; GOTO=""; fi
        fi
      fi
      ;;
    ENTER)
      if [ -n "$GOTO" ]; then
        g=$(( 10#$GOTO )); GOTO=""
        [ "$g" -ge 1 ] && [ "$g" -le "$NROWS" ] && focus_tab "${R_TTY[$g]}"
      elif [ -n "$SEL_IDX" ]; then focus_tab "${R_TTY[$SEL_IDX]}"; fi ;;
    ESC)     GOTO=""; stop_speech ;;
    y|Y)     [ -n "$SEL_IDX" ] && [ "${R_STATUS[$SEL_IDX]}" = waiting ] \
               && { answer_prompt "${R_TTY[$SEL_IDX]}" approve; last_data=0; } ;;
    n|N)     [ -n "$SEL_IDX" ] && [ "${R_STATUS[$SEL_IDX]}" = waiting ] \
               && { answer_prompt "${R_TTY[$SEL_IDX]}" deny; last_data=0; } ;;
    v|V)     if speaking; then stop_speech; else ANSWER="$(briefing_text)"; speak "$ANSWER"; fi ;;
    a|A)     ask ;;
    s|S)     focus_input ;;
    b|B)     broadcast ;;
    ':')     command_mode ;;
    '?')     show_help ;;
    q|Q)     cleanup ;;
  esac
done
